# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get these from your Neon project dashboard → Connection Details
# Use "Pooled connection" string for DATABASE_URL
# Use "Direct connection" string for DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_64_CHAR_RANDOM_STRING"
AUTH_URL="https://ngengwe.com"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Oscar Ballot 2026"
NEXT_PUBLIC_AWARDS_YEAR="98th"
NEXT_PUBLIC_AWARDS_YEAR_NUM="2026"

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL="gngengwe@gmail.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# ─── Ticker (optional) ───────────────────────────────────────────────────────
TICKER_RSS_FEEDS="https://www.hollywoodreporter.com/feed/"
TICKER_FETCH_INTERVAL_MINUTES="30"
